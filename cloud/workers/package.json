{
  "name": "loci-cloud-workers",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:migrate:local": "wrangler d1 migrations apply loci-control --local",
    "db:migrate:remote": "wrangler d1 migrations apply loci-control --remote",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "1.4.8",
    "@cloudflare/workers-types": "^4",
    "typescript": "^5.6",
    "vitest": "^4.1.0",
    "wrangler": "4.153.0"
  }
}
