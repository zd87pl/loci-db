{
  // LOCI Cloud, Phase 0 data and control plane (see docs/CLOUD_PLATFORM_DESIGN.md).
  // Top level = production (`wrangler deploy`); `env.staging` below = `wrangler deploy --env staging`.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "loci-cloud",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  "observability": { "enabled": true },

  // Control plane: organisations' projects, keys, spaces, devices, usage.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "loci-control",
      // Replace with the id printed by `wrangler d1 create loci-control` before the first deploy.
      "database_id": "646af731-91fc-4483-82f7-ac8a850c756d",
      "migrations_dir": "migrations"
    }
  ],

  // Data plane: one SQLite-backed Durable Object per space.
  "durable_objects": {
    "bindings": [{ "name": "SPACE", "class_name": "SpaceObject" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["SpaceObject"] }],

  // Workers AI: speech for the boards (src/speech.ts). Tests never reach it (vitest.config.ts).
  "ai": { "binding": "AI", "remote": true },

  // Per-principal write, query and speech throttles (Workers rate-limiting binding; ids are account-wide).
  "ratelimits": [
    { "name": "WRITE_LIMITER", "namespace_id": "1001", "simple": { "limit": 120, "period": 60 } },
    { "name": "QUERY_LIMITER", "namespace_id": "1002", "simple": { "limit": 600, "period": 60 } },
    { "name": "AI_LIMITER", "namespace_id": "1003", "simple": { "limit": 30, "period": 60 } }
  ],

  "vars": {
    // When set (e.g. "loci.cloud"), requests to <ref>.loci.cloud/v1/... are routed by host.
    // Empty: path routing /p/<ref>/v1/... on workers.dev (Phase 0 default).
    "PROJECT_HOST_SUFFIX": "",
    "DEVICE_TOKEN_TTL_S": "3600"
  },
  // Secrets (wrangler secret put): ADMIN_TOKEN — bootstrap token for POST /admin/projects.

  "env": {
    // A separate Worker with its own control database and Durable Objects, for trying board and
    // firmware changes before production. Bindings are not inherited, so every one is repeated.
    "staging": {
      "name": "loci-cloud-staging",
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "loci-control-staging",
          // Replace with the id printed by `wrangler d1 create loci-control-staging`.
          "database_id": "00000000-0000-0000-0000-000000000000",
          "migrations_dir": "migrations"
        }
      ],
      "durable_objects": {
        "bindings": [{ "name": "SPACE", "class_name": "SpaceObject" }]
      },
      "ai": { "binding": "AI", "remote": true },
      "ratelimits": [
        { "name": "WRITE_LIMITER", "namespace_id": "2001", "simple": { "limit": 120, "period": 60 } },
        { "name": "QUERY_LIMITER", "namespace_id": "2002", "simple": { "limit": 600, "period": 60 } },
        { "name": "AI_LIMITER", "namespace_id": "2003", "simple": { "limit": 30, "period": 60 } }
      ],
      "vars": {
        "PROJECT_HOST_SUFFIX": "",
        "DEVICE_TOKEN_TTL_S": "3600"
      }
      // Secrets: ADMIN_TOKEN again (`wrangler secret put ADMIN_TOKEN --env staging`), different from production's.
    }
  }
}
