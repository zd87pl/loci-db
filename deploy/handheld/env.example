# LOCI handheld environment (Pi values). Copy to /home/ziggy/loci-handheld/env.
# Read by systemd (EnvironmentFile=) and by run_pi.sh (set -a; source env), so keep the
# plain KEY=VALUE form: no "export", no spaces around "=", no $VAR expansion.
# A commented key means "unset" (the code treats an empty value differently from unset).

# ---------------------------------------------------------------- detection source
# none | sim | oak | replay
LOCI_DETECTION_SOURCE=oak
LOCI_SIM_SCENARIO=mug_two_rooms
LOCI_SIM_REALTIME=1
LOCI_SIM_ORACLE_POSE=0
LOCI_SIM_LOOP=0
# seconds to shift the simulated clock into the past (demo of moved/gone in a short run)
#LOCI_SIM_START_OFFSET_S=0
#LOCI_REPLAY_PATH=/home/ziggy/loci-handheld/data/step1.jsonl
#LOCI_RECORD_PATH=/home/ziggy/loci-handheld/data/recording.jsonl

# ---------------------------------------------------------------- OAK-D Lite (DepthAI v3)
LOCI_OAK_FPS=10
# zoo name or path to a .rvc2.tar.xz NNArchive
LOCI_OAK_MODEL=yolov6-nano
LOCI_OAK_USB2=0
# rdf = +x right, +y down, +z forward (verified); ruf flips y (oak_console.py --check-y-sign)
LOCI_OAK_AXES=rdf
# FAST_DENSITY + 2 post-processing shaves is the only preset that fits next to the 8-shave blob
LOCI_OAK_STEREO_PRESET=FAST_DENSITY
LOCI_OAK_PP_SHAVES=2
LOCI_OAK_STEREO_LRC=0
LOCI_OAK_STEREO_EXTENDED=0
LOCI_OAK_CONF=0.5
LOCI_OAK_BBOX_SCALE=0.5
LOCI_OAK_DEPTH_MIN_MM=200
LOCI_OAK_DEPTH_MAX_MM=6000
# median | average | min | max | mode | default
LOCI_OAK_SPATIAL_ALGO=median
LOCI_OAK_STALL_S=5
# 1280x800@5 | 640x400@10 (print 24 cm tags) | off
LOCI_TAG_STREAM=1280x800@5
LOCI_TAG_UNDISTORT=0
DEPTHAI_ZOO_CACHE_PATH=/home/ziggy/loci-handheld/models/zoo
DEPTHAI_ZOO_INTERNET_CHECK=0

# ---------------------------------------------------------------- AprilTag room anchoring
# auto | pyapriltags | aruco | none
LOCI_TAG_DETECTOR=auto
# measured black-square edge in metres; overrides rooms.json when set
#LOCI_TAG_SIZE_M=0.160
LOCI_ROOMS_FILE=/home/ziggy/loci-handheld/rooms.json
LOCI_POSE_HOLD_S=10
LOCI_POSE_STALE_S=60
LOCI_TAG_UPRIGHT_FIX=0

# ---------------------------------------------------------------- label embeddings
# hash | static | auto   (static = potion-base-8M, 256-d)
LOCI_LABEL_EMBEDDER=static
LOCI_EMBED_MODEL_DIR=/home/ziggy/loci-handheld/models/embeddings/potion-base-8M

# ---------------------------------------------------------------- memory / persistence
LOCI_DATA_DIR=/home/ziggy/loci-handheld/data
LOCI_PERSIST=1
LOCI_SNAPSHOT_INTERVAL_S=20
LOCI_JOURNAL_FSYNC_S=1
LOCI_MAX_RECORDS=100000
LOCI_CONSENSUS_REFIRE_MS=2000
LOCI_CONSENSUS_RADIUS_M=0.3
LOCI_DEDUP_RADIUS_M=0.35
LOCI_MOVED_THRESHOLD_M=0.5

# ---------------------------------------------------------------- server
PORT=8001
LOCI_WS_PUSH_HZ=5
# 1 = self-signed HTTPS (needed only for the phone microphone); certs under /home/ziggy/loci-handheld/certs
LOCI_TLS=0
CORS_ORIGINS=*

# ---------------------------------------------------------------- voice backends (voice_pipeline.py)
# openai | piper | edge
TTS_ENGINE=piper
PIPER_MODEL_PATH=/home/ziggy/loci-handheld/models/piper/en_US-lessac-medium.onnx
WHISPER_LOCAL=1
# tiny.en | base.en | small.en  (faster-whisper, int8 on CPU; cached by fetch_models.py --whisper)
WHISPER_LOCAL_MODEL=tiny.en
# 1 = never contact huggingface.co at startup (the Whisper model must already be cached); 0 = allow downloads
HF_HUB_OFFLINE=1
#OPENAI_API_KEY=

# ---------------------------------------------------------------- headset voice loop (headset_voice.py)
# none | headset   -- set to headset once the Bluetooth headset is paired (README: Headset voice)
LOCI_VOICE=none
# keyboard | evdev | vad   (evdev = headset media button; vad = hands-free energy gate)
LOCI_PTT=evdev
# auto | sounddevice | cli   (cli = pw-record/pw-play, no PortAudio needed)
LOCI_AUDIO_BACKEND=auto
LOCI_VOICE_MAX_S=10
LOCI_EARCON=1
# case-insensitive substring of the headset name in /proc/bus/input/devices, e.g. "WH-1000XM4 (AVRCP)"
#LOCI_PTT_DEVICE=AVRCP
# case-insensitive substring of the sounddevice name; unset = system default (set it with wpctl set-default)
#LOCI_AUDIO_IN=pipewire
#LOCI_AUDIO_OUT=pipewire
LOCI_VAD_THRESHOLD=500
LOCI_VAD_SILENCE_S=1.2
# 1 when the headset only sends click events (press and release arrive together)
LOCI_PTT_TOGGLE=0
