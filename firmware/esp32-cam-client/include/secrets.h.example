// Copy this file to include/secrets.h and fill in your values.
// include/secrets.h is git-ignored: never commit Wi-Fi credentials.
#pragma once

#define WIFI_SSID "your-wifi-name"
#define WIFI_PASS "your-wifi-password"

// The LOCI demo host (the Mac today, the Raspberry Pi or the cloud later), no trailing slash.
// Run demo_spatial/run_esp32_demo.sh on the host; it prints this URL.
#define LOCI_HOST "http://192.168.1.23:8002"

// How this board identifies itself to the host (any short string).
#define LOCI_DEVICE_ID "esp32"
