// Copy to main/secrets.h and fill in. main/secrets.h is git-ignored: never commit credentials.
#pragma once

#define WIFI_SSID "your-wifi-name"
#define WIFI_PASS "your-wifi-password"

// The LOCI demo host (the Mac today, the Raspberry Pi or the cloud later), no trailing slash:
// http://<lan-ip>:8002 on the LAN, or https://<hostname> through the Cloudflare Tunnel.
// demo_spatial/run_esp32_demo.sh prints the LAN URL when it starts. The console command
// `host <url>` overrides this at runtime (stored in NVS) so a tunnel URL needs no reflash.
#define LOCI_HOST "http://192.168.1.23:8002"

// How this board identifies itself to the host.
#define LOCI_DEVICE_ID "p4-nano"

// Device token the host expects on every request from outside the LAN (online mode).
// run_esp32_demo.sh creates one in ~/.local/share/loci-esp32/device_token. Leave it empty on a
// LAN-only setup, or store it at runtime with the console command `token <value>` (never logged).
#define LOCI_DEVICE_TOKEN ""
