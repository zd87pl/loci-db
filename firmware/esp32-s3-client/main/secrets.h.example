// Copy to main/secrets.h and fill in. main/secrets.h is git-ignored: never commit credentials.
#pragma once

#define WIFI_SSID "your-wifi-name"
#define WIFI_PASS "your-wifi-password"

// The LOCI demo host, no trailing slash: http://<lan-ip>:8002 on the LAN, or https://<hostname>
// through the Cloudflare Tunnel. The console command `host <url>` overrides this at runtime (NVS).
#define LOCI_HOST "http://192.168.1.23:8002"

// How this board identifies itself to the host (the /esp32?device=<id> page shows its frames).
#define LOCI_DEVICE_ID "meshology"

// Device token for requests from outside the LAN (online mode); or `token <value>` on the console.
#define LOCI_DEVICE_TOKEN ""
